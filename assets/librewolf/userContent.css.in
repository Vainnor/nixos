/* Vainnor - Firefox about: pages (about:preferences, about:addons, about:config and so on).
   The @base..@ placeholders are filled from the system theme (modules/apps/librewolf.nix),
   so this follows meta.theme like everything else.

   Install: about:support > Profile Folder > open or create a "chrome" folder, save this file there as
   userContent.css, set toolkit.legacyUserProfileCustomizations.stylesheets to true in about:config, restart Firefox.

   To change the accent, edit --vn-accent and --vn-accent2 in the first block below:
   lilac  accent #B5A8F5   secondary #d4cdf9
   rose   accent #F0A0BC   secondary #f6c3d5
   mint   accent #8FE3C3   secondary #b0ebd4
   peach  accent #F4B08E   secondary #f8cab3
*/
@-moz-document url-prefix("about:") {
	* {
		--vn-bg0: #@base00@;
		--vn-bg1: #@base01@;
		--vn-bg2: #@base02@;
		--vn-bg4: #@border@;
		--vn-fg: #@base05@;
		--vn-comment: #@base03@;
		--vn-accent: #@base0D@;
		--vn-accent2: #@accent2@;
		--vn-red: #@base08@;
		--vn-orange: #@base09@;
		--vn-yellow: #@base0A@;
		--vn-green: #@base0B@;
		--vn-cyan: #@base0C@;
		--vn-blue: #@base0E@;
	}

	body {
		background-color: var(--vn-bg0) !important;
		color: var(--vn-fg) !important;
	}

	* {
		border-radius: 0px !important;
	}

	button:hover, .button:hover {
		background-color: var(--vn-accent) !important;
		color: var(--vn-bg0) !important;
	}

	* {
		--text-color:							var(--vn-fg) !important;
		--color-accent-primary:					light-dark(color-mix(in srgb, var(--vn-accent) 33%, transparent), var(--vn-accent)) !important;
		--color-accent-secondary:				light-dark(color-mix(in srgb, var(--vn-accent2) 33%, transparent), var(--vn-accent2)) !important;
	}

	* {
		--color-blue-0:   var(--vn-blue) !important;
		--color-blue-10:  var(--vn-blue) !important;
		--color-blue-20:  var(--vn-blue) !important;
		--color-blue-30:  var(--vn-blue) !important;
		--color-blue-40:  var(--vn-blue) !important;
		--color-blue-50:  var(--vn-blue) !important;
		--color-blue-60:  var(--vn-blue) !important;
		--color-blue-70:  var(--vn-blue) !important;
		--color-blue-80:  var(--vn-blue) !important;
		--color-blue-90:  var(--vn-blue) !important;
		--color-cyan-0:   var(--vn-cyan) !important;
		--color-cyan-10:  var(--vn-cyan) !important;
		--color-cyan-20:  var(--vn-cyan) !important;
		--color-cyan-30:  var(--vn-cyan) !important;
		--color-cyan-40:  var(--vn-cyan) !important;
		--color-cyan-50:  var(--vn-cyan) !important;
		--color-cyan-60:  var(--vn-cyan) !important;
		--color-cyan-70:  var(--vn-cyan) !important;
		--color-cyan-80:  var(--vn-cyan) !important;
		--color-cyan-90:  var(--vn-cyan) !important;
		--color-gray-0: #f5f7fb !important;
		--color-gray-05: #f2f3f6 !important;
		--color-gray-10: #e8eaee !important;
		--color-gray-15: #dbdfe6 !important;
		--color-gray-20: #ccd1dc !important;
		--color-gray-25: #bbc2d0 !important;
		--color-gray-30: #a7b1c4 !important;
		--color-gray-35: #929fb6 !important;
		--color-gray-40: #7d8ca9 !important;
		--color-gray-45: #66799c !important;
		--color-gray-50: #51617f !important;
		--color-gray-55: #404d66 !important;
		--color-gray-60: #323d51 !important;
		--color-gray-65: #272f3f !important;
		--color-gray-70: #1e2632 !important;
		--color-gray-75: #181d28 !important;
		--color-gray-80: #131820 !important;
		--color-gray-85: #11151c !important;
		--color-gray-90: #10141b !important;
		--color-green-0:   var(--vn-green) !important;
		--color-green-10:  var(--vn-green) !important;
		--color-green-20:  var(--vn-green) !important;
		--color-green-30:  var(--vn-green) !important;
		--color-green-40:  var(--vn-green) !important;
		--color-green-50:  var(--vn-green) !important;
		--color-green-60:  var(--vn-green) !important;
		--color-green-70:  var(--vn-green) !important;
		--color-green-80:  var(--vn-green) !important;
		--color-green-90:  var(--vn-green) !important;
		--color-orange-0:   var(--vn-orange) !important;
		--color-orange-10:  var(--vn-orange) !important;
		--color-orange-20:  var(--vn-orange) !important;
		--color-orange-30:  var(--vn-orange) !important;
		--color-orange-40:  var(--vn-orange) !important;
		--color-orange-50:  var(--vn-orange) !important;
		--color-orange-60:  var(--vn-orange) !important;
		--color-orange-70:  var(--vn-orange) !important;
		--color-orange-80:  var(--vn-orange) !important;
		--color-orange-90:  var(--vn-orange) !important;
		--color-pink-0:   var(--vn-accent) !important;
		--color-pink-10:  var(--vn-accent) !important;
		--color-pink-20:  var(--vn-accent) !important;
		--color-pink-30:  var(--vn-accent) !important;
		--color-pink-40:  var(--vn-accent) !important;
		--color-pink-50:  var(--vn-accent) !important;
		--color-pink-60:  var(--vn-accent) !important;
		--color-pink-70:  var(--vn-accent) !important;
		--color-pink-80:  var(--vn-accent) !important;
		--color-pink-90:  var(--vn-accent) !important;
		--color-purple-0:   var(--vn-accent) !important;
		--color-purple-10:  var(--vn-accent) !important;
		--color-purple-20:  var(--vn-accent) !important;
		--color-purple-30:  var(--vn-accent) !important;
		--color-purple-40:  var(--vn-accent) !important;
		--color-purple-50:  var(--vn-accent) !important;
		--color-purple-60:  var(--vn-accent) !important;
		--color-purple-70:  var(--vn-accent) !important;
		--color-purple-80:  var(--vn-accent) !important;
		--color-purple-90:  var(--vn-accent) !important;
		--color-red-0:   var(--vn-red) !important;
		--color-red-10:  var(--vn-red) !important;
		--color-red-20:  var(--vn-red) !important;
		--color-red-30:  var(--vn-red) !important;
		--color-red-40:  var(--vn-red) !important;
		--color-red-50:  var(--vn-red) !important;
		--color-red-60:  var(--vn-red) !important;
		--color-red-70:  var(--vn-red) !important;
		--color-red-80:  var(--vn-red) !important;
		--color-red-90:  var(--vn-red) !important;
		--color-violet-0:   var(--vn-accent) !important;
		--color-violet-10:  var(--vn-accent) !important;
		--color-violet-20:  var(--vn-accent) !important;
		--color-violet-30:  var(--vn-accent) !important;
		--color-violet-40:  var(--vn-accent) !important;
		--color-violet-50:  var(--vn-accent) !important;
		--color-violet-60:  var(--vn-accent) !important;
		--color-violet-70:  var(--vn-accent) !important;
		--color-violet-80:  var(--vn-accent) !important;
		--color-violet-90:  var(--vn-accent) !important;
		--color-violet-desaturated-0:   var(--vn-accent) !important;
		--color-violet-desaturated-10:  var(--vn-accent) !important;
		--color-violet-desaturated-20:  var(--vn-accent) !important;
		--color-violet-desaturated-30:  var(--vn-accent) !important;
		--color-violet-desaturated-40:  var(--vn-accent) !important;
		--color-violet-desaturated-50:  var(--vn-accent) !important;
		--color-violet-desaturated-60:  var(--vn-accent) !important;
		--color-violet-desaturated-70:  var(--vn-accent) !important;
		--color-violet-desaturated-80:  var(--vn-accent) !important;
		--color-violet-desaturated-90:  var(--vn-accent) !important;
		--color-yellow-0:   var(--vn-yellow) !important;
		--color-yellow-10:  var(--vn-yellow) !important;
		--color-yellow-20:  var(--vn-yellow) !important;
		--color-yellow-30:  var(--vn-yellow) !important;
		--color-yellow-40:  var(--vn-yellow) !important;
		--color-yellow-50:  var(--vn-yellow) !important;
		--color-yellow-60:  var(--vn-yellow) !important;
		--color-yellow-70:  var(--vn-yellow) !important;
		--color-yellow-80:  var(--vn-yellow) !important;
		--color-yellow-90:  var(--vn-yellow) !important;
	}

	* {
		--background-color-box:					var(--vn-bg1) !important;
		--background-color-box-info:			var(--vn-bg1) !important;
		--background-color-information:		    var(--vn-bg2) !important;
		--background-color-canvas:				var(--vn-bg0) !important;
		--border-color:							var(--vn-bg4) !important;
		--border-color-deemphasized:			var(--vn-bg4) !important;
		--button-background-color-muted:		var(--vn-bg2) !important;
		--button-text-color-ghost-disabled:		var(--vn-comment) !important;
		--button-border:						2px solid var(--border-color) !important;
		--table-row-background-color-alternate:	var(--vn-bg1) !important;
		--text-color-accent-primary-selected:	var(--vn-bg0) !important;
	}

	* {
		--table-background-color:			var(--background-color-box) !important;
		--table-border-color:				var(--border-color) !important;
		--table-header-background-color:	var(--color-accent-primary) !important;
		--table-header-text-color:			var(--vn-bg0) !important;
		--table-row-background-color:		var(--background-color-canvas) !important;
	}
}
